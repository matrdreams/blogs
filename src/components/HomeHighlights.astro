---
import { SITE } from "../config";
import type { Post } from "../lib/posts";
import { countBy, formatDate, postHref, taxonomyHref } from "../lib/posts";

interface Props {
  posts: Post[];
  allPosts: Post[];
}

const { posts, allPosts } = Astro.props;
const categories = countBy(allPosts, (post) => [post.data.category]);
const tags = countBy(allPosts, (post) => post.data.tags).slice(0, 6);
---

<div class="journal-content">
  <section class="journal-writing" id="writing" aria-labelledby="recent-posts-title">
    <header class="journal-section-heading">
      <div class="journal-section-title">
        <span class="section-index" aria-hidden="true">01 /</span>
        <h2 id="recent-posts-title">文章手记</h2>
        <span class="journal-count">{String(allPosts.length).padStart(2, "0")}</span>
      </div>
      <a class="journal-text-link" href="/archive/">全部文章 <span aria-hidden="true">↗</span></a>
    </header>

    <div class="journal-posts">
      {posts.map((post, index) => (
        <article class="journal-post">
          <div class="journal-post-meta">
            <a href={taxonomyHref("categories", post.data.category)}>{post.data.category}</a>
            <span aria-hidden="true">/</span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            <span class="journal-post-number" aria-hidden="true">NO. {String(index + 1).padStart(2, "0")}</span>
          </div>
          <h3>
            <a href={postHref(post)}>
              <span>{post.data.title}</span>
              <span class="journal-post-arrow" aria-hidden="true">↗</span>
            </a>
          </h3>
          <p class="journal-post-description">{post.data.description}</p>
          <div class="journal-post-tags" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <a href={taxonomyHref("tags", tag)}>{tag}</a>
            ))}
          </div>
        </article>
      ))}
      {posts.length === 0 && <p class="empty-state">手记正在酝酿，改天再来看看。</p>}
    </div>
    <a class="journal-archive-link" href="/archive/">去书架看看 <span>全部 {allPosts.length} 篇文章 <span aria-hidden="true">→</span></span></a>
  </section>

  <aside class="journal-margin" aria-label="关于博客与主题">
    <section class="journal-about" id="about" aria-labelledby="about-title">
      <p class="journal-margin-label">页边小记 <span aria-hidden="true">✳</span></p>
      <h2 id="about-title">你好，我是 Kun<span>。</span></h2>
      <p>{SITE.description}</p>
      <div class="journal-about-signoff">保持好奇，缓慢更新。<span class="journal-signature" aria-hidden="true">Kun</span></div>
    </section>

    {(categories.length > 0 || tags.length > 0) && (
      <section class="journal-topics" aria-labelledby="home-topics-title">
        <div class="journal-margin-heading">
          <h2 id="home-topics-title">沿着主题阅读</h2>
          <span aria-hidden="true">INDEX</span>
        </div>
        <div class="journal-category-list">
          {categories.map(({ name, count }) => (
            <a href={taxonomyHref("categories", name)}><span>{name}</span><span>{String(count).padStart(2, "0")} <span aria-hidden="true">↗</span></span></a>
          ))}
        </div>
        <div class="journal-topic-tags">
          {tags.map(({ name }) => <a href={taxonomyHref("tags", name)}>{name}</a>)}
        </div>
        <a class="journal-text-link" href="/topics/">浏览主题目录 <span aria-hidden="true">↗</span></a>
      </section>
    )}
  </aside>
</div>
