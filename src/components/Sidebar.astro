---
import type { Post } from "../lib/posts";
import { countBy, taxonomyHref } from "../lib/posts";
import { SITE } from "../config";

interface Props { posts: Post[] }
const { posts } = Astro.props;
const categories = countBy(posts, (post) => [post.data.category]);
const tags = countBy(posts, (post) => post.data.tags);
---

<aside class="sidebar">
  <section class="side-section">
    <h2>分类</h2>
    <div class="category-list">
      {categories.map(({ name, count }) => (
        <a href={taxonomyHref("categories", name)}>{name} <span>{String(count).padStart(2, "0")}</span></a>
      ))}
    </div>
  </section>
  <section class="side-section">
    <h2>标签</h2>
    <div class="tag-list">
      {tags.map(({ name }) => <a href={taxonomyHref("tags", name)}>{name}</a>)}
    </div>
  </section>
  <section class="side-section side-note">
    <h2>联系</h2>
    <p>如果你也在想相似的问题，欢迎讨论产品、技术、阅读，或者一个还没有名字的想法。</p>
    <a href={`mailto:${SITE.email}`}>给我写信 →</a>
  </section>
</aside>
