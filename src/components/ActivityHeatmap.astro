---
import type { Post } from "../lib/posts";

interface Props { posts: Post[] }
const { posts } = Astro.props;

const WEEK_COUNT = 52;
const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000;
const WEEK_IN_MILLISECONDS = 7 * DAY_IN_MILLISECONDS;

const utcDay = (date: Date) => new Date(Date.UTC(
  date.getUTCFullYear(),
  date.getUTCMonth(),
  date.getUTCDate(),
));

const compactDate = (date: Date, includeYear = true) => {
  const monthDay = `${String(date.getUTCMonth() + 1).padStart(2, "0")}.${String(date.getUTCDate()).padStart(2, "0")}`;
  return includeYear ? `${date.getUTCFullYear()}.${monthDay}` : monthDay;
};

const now = new Date();
const todayUtc = utcDay(now);
const currentWeekStart = new Date(todayUtc);
currentWeekStart.setUTCDate(todayUtc.getUTCDate() - ((todayUtc.getUTCDay() + 6) % 7));

const start = new Date(currentWeekStart);
start.setUTCDate(currentWeekStart.getUTCDate() - (WEEK_COUNT - 1) * 7);

const end = new Date(currentWeekStart);
end.setUTCDate(currentWeekStart.getUTCDate() + 6);

const weekCounts = Array<number>(WEEK_COUNT).fill(0);
for (const post of posts) {
  const activityDates = [post.data.publishedAt];
  if (post.data.updatedAt) activityDates.push(post.data.updatedAt);

  const postWeekIndexes = new Set<number>();
  for (const activityDate of activityDates) {
    const date = utcDay(activityDate);
    if (date < start || date > todayUtc) continue;

    const weekIndex = Math.floor((date.getTime() - start.getTime()) / WEEK_IN_MILLISECONDS);
    if (weekIndex >= 0 && weekIndex < WEEK_COUNT) postWeekIndexes.add(weekIndex);
  }

  for (const weekIndex of postWeekIndexes) weekCounts[weekIndex] += 1;
}

const longDateLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const weeks = weekCounts.map((count, index) => {
  const weekStart = new Date(start);
  weekStart.setUTCDate(start.getUTCDate() + index * 7);

  const weekEnd = new Date(weekStart);
  weekEnd.setUTCDate(weekStart.getUTCDate() + 6);

  const monthAnchor = new Date(weekStart);
  monthAnchor.setUTCDate(weekStart.getUTCDate() + 3);

  const range = `${compactDate(weekStart)}—${compactDate(weekEnd, weekEnd.getUTCFullYear() !== weekStart.getUTCFullYear())}`;
  const countLabel = count ? `${count} 篇文章更新` : "无更新";

  return {
    index,
    monthAnchor,
    count,
    level: Math.min(count, 3),
    detail: `${range} · ${countLabel}`,
    accessibleLabel: `${longDateLabel.format(weekStart)}至${longDateLabel.format(weekEnd)}，${countLabel}`,
  };
});

const monthNames = ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"];
const monthGroups: Array<{
  key: string;
  year: number;
  label: string;
  weeks: typeof weeks;
}> = [];

for (const week of weeks) {
  const year = week.monthAnchor.getUTCFullYear();
  const month = week.monthAnchor.getUTCMonth();
  const key = `${year}-${month}`;
  const currentGroup = monthGroups.at(-1);

  if (!currentGroup || currentGroup.key !== key) {
    monthGroups.push({ key, year, label: monthNames[month], weeks: [week] });
  } else {
    currentGroup.weeks.push(week);
  }
}

const yearBands: Array<{ year: number; monthCount: number }> = [];
for (const month of monthGroups) {
  const currentBand = yearBands.at(-1);
  if (!currentBand || currentBand.year !== month.year) {
    yearBands.push({ year: month.year, monthCount: 1 });
  } else {
    currentBand.monthCount += 1;
  }
}

const publishedCount = posts.filter(({ data }) => {
  const date = utcDay(data.publishedAt);
  return date >= start && date <= todayUtc;
}).length;
const activeWeekCount = weeks.filter(({ count }) => count > 0).length;
const selectedWeekIndex = weeks.reduce(
  (selectedIndex, week, index) => week.count >= weeks[selectedIndex].count ? index : selectedIndex,
  0,
);
const selectedWeek = weeks[selectedWeekIndex];
const periodLabel = `${compactDate(start).slice(0, 7)} — ${compactDate(end).slice(0, 7)}`;
---

<section class="activity" aria-labelledby="activity-title" data-weekly-activity>
  <header class="activity-header">
    <h2 id="activity-title">更新记录</h2>
    <p>过去 52 周发布 {publishedCount} 篇文章，活跃于 {activeWeekCount} 周。每格代表一周，颜色越深，表示该周更新越多。</p>
  </header>

  <div class="activity-map" aria-label="过去 52 周的文章更新记录">
    <div
      class="activity-years"
      style={`--activity-month-count: ${monthGroups.length};`}
      aria-hidden="true"
    >
      {yearBands.map((band) => (
        <span style={`grid-column: span ${band.monthCount};`}>{band.year}</span>
      ))}
    </div>

    <div
      class="activity-months"
      style={`--activity-month-count: ${monthGroups.length};`}
    >
      {monthGroups.map((month) => (
        <div class="activity-month" aria-label={`${month.year}年${month.label}`}>
          <div class="activity-week-cells">
            {month.weeks.map((week) => (
              <button
                type="button"
                class:list={["activity-week-cell", `level-${week.level}`]}
                data-week-cell
                data-detail={week.detail}
                title={week.accessibleLabel}
                aria-label={week.accessibleLabel}
                aria-pressed={week.index === selectedWeekIndex ? "true" : "false"}
              />
            ))}
          </div>
          <span class="activity-month-label" aria-hidden="true">{month.label}</span>
        </div>
      ))}
    </div>

    <div class="activity-foot">
      <div class="activity-range">
        <span>{periodLabel}</span>
        <strong data-week-detail aria-live="polite">{selectedWeek.detail}</strong>
      </div>
      <span class="activity-legend" aria-label="每周文章更新数量：从 0 到 3 篇以上">
        <span>0</span>
        <i class="level-0" aria-hidden="true"></i>
        <i class="level-1" aria-hidden="true"></i>
        <i class="level-2" aria-hidden="true"></i>
        <i class="level-3" aria-hidden="true"></i>
        <span>3+</span>
      </span>
    </div>
  </div>
</section>

<script>
  const activity = document.querySelector<HTMLElement>("[data-weekly-activity]");

  if (activity) {
    const detail = activity.querySelector<HTMLElement>("[data-week-detail]");
    const cells = activity.querySelectorAll<HTMLButtonElement>("[data-week-cell]");

    const selectWeek = (selectedCell: HTMLButtonElement) => {
      for (const cell of cells) cell.setAttribute("aria-pressed", "false");
      selectedCell.setAttribute("aria-pressed", "true");
      if (detail) detail.textContent = selectedCell.dataset.detail ?? "";
    };

    for (const cell of cells) {
      cell.addEventListener("mouseenter", () => selectWeek(cell));
      cell.addEventListener("focus", () => selectWeek(cell));
      cell.addEventListener("click", () => selectWeek(cell));
    }
  }
</script>
