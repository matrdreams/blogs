---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { countBy, getPublishedPosts, taxonomyHref } from "../../lib/posts";

const posts = await getPublishedPosts();
const categories = countBy(posts, (post) => [post.data.category]);
---

<BaseLayout title="分类" description="按分类浏览博客文章。">
  <SiteHeader />
  <main class="page">
    <header class="collection-header">
      <div><p class="eyebrow">浏览文章</p><h1>分类</h1></div>
      <p>每篇文章属于一个主要分类，方便从更完整的主题脉络进入。</p>
    </header>
    <div class="taxonomy-grid">
      {categories.map(({ name, count }) => (
        <a class="taxonomy-card" href={taxonomyHref("categories", name)}>
          <strong>{name}</strong><span>{count} 篇</span>
        </a>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
