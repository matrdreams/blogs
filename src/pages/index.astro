---
import ActivityHeatmap from "../components/ActivityHeatmap.astro";
import HomeHighlights from "../components/HomeHighlights.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 8);
---

<BaseLayout>
  <SiteHeader />
  <main class="page">
    <section class="intro" id="about">
      <div>
        <p class="kicker">个人博客 · 缓慢更新</p>
        <h1>写一些值得留下的事。</h1>
      </div>
    </section>

    <HomeHighlights posts={recentPosts} allPosts={posts} />

    <ActivityHeatmap posts={posts} />
  </main>
  <SiteFooter showEmail />
</BaseLayout>
